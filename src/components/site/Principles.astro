---
import { principles } from "@/lib/content";
---

<section class="shell flex flex-col gap-12 py-20 md:gap-14 md:py-[110px]" aria-labelledby="principles-title">
  <div class="flex flex-col gap-5">
    <p class="label" data-fade>(03) — How I work</p>
    <h2 id="principles-title" class="section-title" data-split>
      Speed and quality, both non‑negotiable.
    </h2>
  </div>

  <div class="grid items-center gap-6 lg:grid-cols-[minmax(0,1fr)_240px_minmax(0,1fr)] lg:gap-10" data-principles>
    <div class="flex flex-col" data-principle-side="left">
      <h3 class="pb-3 font-display text-[32px] text-patina md:text-[56px] md:tracking-[-0.02em]">Fast to ship</h3>
      <ul>
        {principles.fast.map((item) => (
          <li class="border-t border-rule py-3 text-[15px] leading-[1.5] text-body md:py-4 md:text-[17px]">{item}</li>
        ))}
      </ul>
    </div>

    <p
      class="text-center font-display text-amp leading-[0.9] text-sand select-none"
      aria-hidden="true"
      data-amp
    >
      &amp;
    </p>

    <div class="flex flex-col" data-principle-side="right">
      <h3 class="pb-3 font-display text-[32px] text-sand md:text-[56px] md:tracking-[-0.02em]">Built to last</h3>
      <ul>
        {principles.last.map((item) => (
          <li class="border-t border-rule py-3 text-[15px] leading-[1.5] text-body md:py-4 md:text-[17px]">{item}</li>
        ))}
      </ul>
    </div>
  </div>
</section>
