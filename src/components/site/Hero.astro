---
import { Image } from "astro:assets";
import { currentRole, links } from "@/lib/content";
---

<section class="shell pt-12 pb-16 md:pt-[72px] md:pb-24" aria-labelledby="hero-title">
  <p class="label pb-6 md:pb-7" data-hero-fade>
    (00) — Portfolio 2026 · Full-stack engineering
  </p>
  <h1 id="hero-title" class="display" data-hero-title>
    <span class="block">Fast to ship.</span>
    <span class="block text-sand">Built to last.</span>
  </h1>

  <div
    class="grid gap-7 pt-10 md:grid-cols-[minmax(0,540px)_minmax(0,580px)] md:items-end md:justify-between md:gap-x-10 md:pt-[72px]"
  >
    <p
      class="text-lg leading-[1.5] text-body md:col-start-2 md:row-start-1 md:text-[22px] md:leading-[1.45]"
      data-hero-fade
    >
      I design APIs, build reliable interfaces, and ship systems that are
      measurable, maintainable, and ready to scale.
    </p>

    <div
      class="flex items-center gap-4 rounded-2xl border border-rule bg-stoa-2 p-3 pr-5 md:col-start-1 md:row-span-2 md:row-start-1 md:self-end md:gap-5 md:p-3.5"
      data-hero-fade
    >
      <div
        class="flex h-12 w-[110px] shrink-0 items-center justify-center overflow-hidden rounded-xl bg-tile md:h-[60px] md:w-[140px]"
      >
        <Image
          src={currentRole.logo}
          alt="Cloudypedia"
          width={280}
          class="h-auto w-full"
          loading="eager"
        />
      </div>
      <div class="flex flex-col gap-1">
        <p class="label flex items-center gap-2 text-patina!">
          <span class="size-2 rounded-full bg-patina" aria-hidden="true"></span>
          Currently
        </p>
        <p class="text-[15px] font-medium text-marble md:text-[17px]">
          Frontend Software Engineer @ Cloudypedia
        </p>
        <p class="text-[13px] text-muted md:text-sm">
          Since Nov 2025 · Remote, Canada
        </p>
      </div>
    </div>

    <div
      class="flex flex-col gap-3 sm:flex-row md:col-start-2 md:row-start-2"
      data-hero-fade
    >
      <a
        href="#work"
        class="rounded-full bg-sand px-6 py-4 text-center text-[15px] font-semibold text-night transition-colors hover:bg-marble"
        data-magnetic
      >
        View selected work ↓
      </a>
      <a
        href={links.resume}
        target="_blank"
        rel="noopener"
        class="rounded-full border border-muted px-6 py-4 text-center text-[15px] font-medium text-marble transition-colors hover:border-marble"
        data-magnetic
      >
        Résumé ↗
      </a>
    </div>
  </div>
</section>
