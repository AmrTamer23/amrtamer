---
interface Props {
  title: string;
  id?: string;
  class?: string;
}

const { title, id, class: className } = Astro.props;
const headingId = `${(id ?? title).toLowerCase().replace(/[^a-z0-9]+/g, "-")}-title`;
---

<section
  id={id}
  class:list={["shell grid scroll-mt-6 gap-4 pt-14 md:grid-cols-[280px_minmax(0,1040px)] md:gap-10 md:pt-24", className]}
  aria-labelledby={headingId}
>
  <h2 id={headingId} class="font-display text-[26px] leading-[1.1] md:text-[30px]" data-fade>
    {title}
  </h2>
  <div class="min-w-0">
    <slot />
  </div>
</section>
