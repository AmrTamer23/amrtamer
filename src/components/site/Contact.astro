---
import Section from "@/components/site/Section.astro";
import { links } from "@/lib/content";
---

<Section title="Contact" id="contact">
  <div class="flex flex-col gap-4 border-t border-rule py-5 md:gap-[18px] md:py-[22px]" data-fade>
    <a href={links.email} class="link-underline w-fit font-display text-2xl text-sand md:text-[44px]">
      {links.emailLabel}
    </a>
    <ul class="flex gap-5 text-[15px] text-body md:gap-7 md:text-base">
      <li><a href={links.linkedin} target="_blank" rel="noopener" class="border-b border-rule pb-0.5 transition-colors hover:border-body">LinkedIn ↗</a></li>
      <li><a href={links.github} target="_blank" rel="noopener" class="border-b border-rule pb-0.5 transition-colors hover:border-body">GitHub ↗</a></li>
      <li><a href={links.resume} target="_blank" rel="noopener" class="border-b border-rule pb-0.5 transition-colors hover:border-body">Résumé ↗</a></li>
    </ul>
  </div>
</Section>
