---
import { stats } from "@/lib/content";
---

<section class="shell pb-24 md:pb-[110px]" aria-label="Results">
  <p class="label" data-fade>Receipts — the last two years</p>
  <ul
    class="grid grid-cols-2 gap-x-4 gap-y-9 pt-8 md:grid-cols-4 md:gap-5"
    data-stagger
  >
    {
      stats.map((stat) => (
        <li class="flex flex-col gap-3 border-t border-rule pt-4 md:pt-5">
          <p class="font-display text-stat leading-[0.95] tracking-[-0.035em]">
            {stat.prefix}<span data-count={stat.value}>{stat.value.toLocaleString("en-US")}</span>{stat.suffix}
          </p>
          <p class="text-[13px] leading-[1.45] text-body md:max-w-[280px] md:text-base">
            {stat.label}
          </p>
        </li>
      ))
    }
  </ul>
</section>
