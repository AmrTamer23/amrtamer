---
import { Image } from "astro:assets";
import avatar from "../../../public/avatar.webp";
import { skills } from "@/lib/content";

const facts = [
  { label: "Education", title: "BSc Computer Science", note: "Graduated 2022" },
  {
    label: "Certifications",
    title: "GCP · AWS",
    note: "Professional Cloud Architect; Certified Cloud Practitioner",
  },
  {
    label: "Strongest at",
    title: "Full-stack",
    note: "API design, React / Next.js, NestJS services",
  },
];
---

<section class="bg-stoa py-20 md:py-[110px]" aria-labelledby="profile-title">
  <div class="shell grid gap-10 md:grid-cols-[200px_minmax(0,1fr)] md:gap-12">
    <div class="flex flex-col gap-6" data-fade>
      <p class="label">(04) — Profile</p>
      <Image
        src={avatar}
        alt="Portrait of Amr Tamer"
        width={400}
        height={533}
        class="aspect-square size-[160px] rounded-lg object-cover object-top md:size-[200px]"
      />
    </div>

    <div class="flex flex-col gap-12 md:gap-14">
      <h2
        id="profile-title"
        class="font-display text-[32px] leading-[1.1] tracking-[-0.02em] md:text-[56px] md:leading-[1.08]"
        data-split
      >
        A computer science graduate who likes owning the whole path—API,
        interface, and the release that ships them.
      </h2>

      <div class="relative grid gap-8 pt-6 sm:grid-cols-3 sm:gap-6">
        <span class="absolute inset-x-0 top-0 h-px bg-rule" data-rule aria-hidden="true"></span>
        {
          facts.map((fact) => (
            <div class="flex flex-col gap-2.5" data-fade>
              <p class="label">{fact.label}</p>
              <p class="font-display text-[26px] leading-tight md:text-[30px]">{fact.title}</p>
              <p class="text-[15px] leading-[1.5] text-body">{fact.note}</p>
            </div>
          ))
        }
      </div>

      <ul class="flex flex-wrap gap-2" aria-label="Skills" data-stagger>
        {
          skills.map((skill) => (
            <li class="rounded-full border border-rule px-3.5 py-2 text-sm text-body">{skill}</li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
