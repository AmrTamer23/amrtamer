---
import { siteConfig } from "@/config/site.config";
import "@/styles/globals.css";
import facultyGlyphicUrl from "@fontsource/faculty-glyphic/files/faculty-glyphic-latin-400-normal.woff2?url";
import valleySans400Url from "@fontsource/valley-sans/files/valley-sans-latin-400-normal.woff2?url";
import valleySans500Url from "@fontsource/valley-sans/files/valley-sans-latin-500-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  imageAlt?: string;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  ogImage,
  imageAlt,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, siteConfig.origin).href;
const resolvedOgImage = ogImage ?? siteConfig.og;
const resolvedImageAlt =
  imageAlt ?? `${siteConfig.name} — Fast to ship. Built to last.`;

const xHandle = `@${siteConfig.socials.x.split("/").pop()}`;

const pageTitle =
  title === siteConfig.title ? title : `${title} | ${siteConfig.name}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={siteConfig.keywords.join(", ")} />
    <meta name="creator" content={siteConfig.name} />
    <meta name="theme-color" content="#0e1716" />
    <meta name="color-scheme" content="dark" />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />

    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={resolvedImageAlt} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={xHandle} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:image:alt" content={resolvedImageAlt} />

    <link rel="preconnect" href="https://us.i.posthog.com" />

    <link rel="preload" href={facultyGlyphicUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={valleySans400Url} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={valleySans500Url} as="font" type="font/woff2" crossorigin />

    <!--
      Opt into motion pre-states before first paint. If the animation bundle
      never reports ready, drop the class so content can't stay hidden.
    -->
    <script is:inline>
      (function () {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        var root = document.documentElement;
        root.classList.add("motion");
        setTimeout(function () {
          if (!window.__motionReady) root.classList.remove("motion");
        }, 4000);
      })();
    </script>

    <script>
      import posthog from "posthog-js";

      posthog.init("phc_SSnD5HnekdLEy0F1vt8A2DBeqP70kTV4bydu0GaJu8Q", {
        api_host: "https://t.amrtamer.dev",
        defaults: "2026-01-30",
      });
    </script>
    <slot name="head" />
  </head>
  <body class="bg-night text-marble">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-full focus:bg-sand focus:px-4 focus:py-2 focus:text-night"
    >
      Skip to content
    </a>
    <slot />
    <script>
      import "@/scripts/motion";
    </script>
  </body>
</html>
