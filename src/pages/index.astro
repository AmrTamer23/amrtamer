---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/site/Header.astro";
import Intro from "@/components/site/Intro.astro";
import Experience from "@/components/site/Experience.astro";
import Work from "@/components/site/Work.astro";
import Contact from "@/components/site/Contact.astro";
import Footer from "@/components/site/Footer.astro";
---

<BaseLayout>
  <div id="top">
    <Header />
    <main id="main">
      <Intro />
      <Experience />
      <Work />
      <Contact />
    </main>
    <Footer />
  </div>
</BaseLayout>
