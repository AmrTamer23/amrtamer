---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/site/Header.astro";
import Hero from "@/components/site/Hero.astro";
import Proof from "@/components/site/Proof.astro";
import Experience from "@/components/site/Experience.astro";
import Work from "@/components/site/Work.astro";
import Principles from "@/components/site/Principles.astro";
import Profile from "@/components/site/Profile.astro";
import Contact from "@/components/site/Contact.astro";
---

<BaseLayout>
  <div id="top">
    <Header />
    <main id="main">
      <Hero />
      <Proof />
      <Experience />
      <Work />
      <Principles />
      <Profile />
    </main>
    <Contact />
  </div>
</BaseLayout>
