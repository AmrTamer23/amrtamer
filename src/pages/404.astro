---
// Built as 404.html. Ensure the host serves this route with HTTP 404 for unknown paths.
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Page Not Found">
  <main
    id="main"
    class="shell flex min-h-dvh flex-col items-start justify-center gap-6"
  >
    <p class="label">(404) — Lost in the ruins</p>
    <h1 class="display">
      <span class="block">This page</span>
      <span class="block text-sand">didn’t last.</span>
    </h1>
    <a
      href="/"
      class="mt-4 rounded-full bg-sand px-6 py-4 text-[15px] font-semibold text-night transition-colors hover:bg-marble"
    >
      Back home →
    </a>
  </main>
</BaseLayout>
