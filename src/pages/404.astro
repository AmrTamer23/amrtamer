---
// Built as 404.html. Ensure the host serves this route with HTTP 404 for unknown paths.
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Page Not Found">
  <main id="main" class="shell flex min-h-dvh flex-col items-start justify-center gap-5">
    <p class="label">404</p>
    <h1 class="font-display text-[52px] leading-[0.95] tracking-[-0.03em] md:text-[112px]">
      Page not found
    </h1>
    <a href="/" class="link-underline text-base text-sand md:text-lg">Back to the homepage →</a>
  </main>
</BaseLayout>
